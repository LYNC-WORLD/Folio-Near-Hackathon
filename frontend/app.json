{
  "expo": {
    "name": "folio",
    "slug": "folio",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0B0E",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.folio.money",
      "appleTeamId": "39GQR656YG",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "app.folio.money",
      "adaptiveIcon": {
        "backgroundColor": "#0A0B0E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1037438594396-a10qm1r0p4evjdnptubbj6kk7rbumpta"
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0B0E",
          "image": "./assets/splash-blank.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0A0B0E",
            "image": "./assets/splash-blank.png"
          }
        }
      ],
      "expo-web-browser",
      "expo-image",
      "expo-apple-authentication"
    ],
    "extra": {
      "eas": {
        "projectId": "a2d7d699-aaaf-4606-b109-dd69e0e72c01"
      }
    },
    "owner": "shanu12joshi"
  }
}