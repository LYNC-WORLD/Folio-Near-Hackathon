{
  "expo": {
    "name": "folio",
    "slug": "folio",
    "scheme": "folio",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0B0E",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.folio.money",
      "appleTeamId": "39GQR656YG",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Used to verify your identity when buying or withdrawing.",
        "NSMicrophoneUsageDescription": "Used to verify your identity when buying or withdrawing.",
        "NSLocationWhenInUseUsageDescription": "Used to confirm where purchases are made.",
        "NSPhotoLibraryUsageDescription": "Used to upload identity documents.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.folio.money",
      "adaptiveIcon": {
        "backgroundColor": "#0A0B0E",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1037438594396-a10qm1r0p4evjdnptubbj6kk7rbumpta"
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0B0E",
          "image": "./assets/splash-blank.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0A0B0E",
            "image": "./assets/splash-blank.png"
          }
        }
      ],
      "expo-web-browser",
      "expo-image",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-status-bar",
      "@crossmint/client-sdk-react-native-ui"
    ],
    "extra": {
      "eas": {
        "projectId": "ebedc382-cc57-489c-87ef-caac465b7666"
      }
    },
    "owner": "shikamaru_nara-2"
  }
}
